# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Display currency ----
# The UI shows EUR by default and converts USD quotes at the live USD→EUR rate
# (Yahoo USDEUR=X, cached 10 min); switch to USD in the header at any time.
# Set a fixed rate here to bypass live FX (offline use); leave empty for live.
USD_EUR_RATE=

# ---- MongoDB (news, deal & daily market archive) ----
# Local install or the mongo container from docker-compose.yml.
MONGODB_URI=mongodb://127.0.0.1:27017/marketpilot
MONGODB_DB=marketpilot

# ---- Daily news ingest ----
# Collects Yahoo Finance headlines and business deals for the focus universe
# once a day, and shortly after boot. Leave empty/true for the defaults.
NEWS_INGEST_ENABLED=true
NEWS_INGEST_ON_BOOT=true
NEWS_INGEST_HOUR=18

# ---- Daily market snapshot archive ----
# Stores one Yahoo Finance snapshot per tracked symbol per session (quote,
# plan, score, call, indicators, news sentiment) and feeds it back into every
# decision. Runs shortly after boot, then once a day after ARCHIVE_HOUR.
ARCHIVE_ENABLED=true
ARCHIVE_ON_BOOT=true
ARCHIVE_HOUR=22
ARCHIVE_RETENTION_DAYS=400

# ---- LLM agent ----
# auto = pick the first configured provider, otherwise use the built-in
# rule-based analyst (the app still works with no key at all).
# Image questions in the agent chat need a vision-capable model: most OpenAI,
# Anthropic and Gemini chat models read images; on Ollama use a multimodal
# model such as llava or qwen2.5vl (llama3.1 is text-only).
LLM_PROVIDER=auto

# OpenAI or any OpenAI-compatible gateway (e.g. OpenLLM, Together, Groq, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter example: point the same three vars at OpenRouter and pick a
# reasoning model that supports tool calling + structured output.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-v4-pro

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
